# JOSH — video platform environment contract
#
# Copy to `.env` for local development, or add these keys in
# AppJet Settings → Environment variables for the deployed app.
# Every key is optional: with none of them set, JOSH runs on its local
# store and says so in /api/status. No fake values are baked into the code.

# Port the server listens on (the deployment port must match).
PORT=3000

# Where records and uploaded files are written.
# Must be a writable directory; a mounted disk path is fine.
DATA_DIR=./data

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=128

# Secret used to sign session cookies. Generate a long random value.
# The server generates a per-process secret when this is unset, which
# logs everyone out on restart.
SESSION_SECRET=

# --- Supabase (stage 1/2 activation) ---------------------------------
# Create a free project at https://supabase.com, then apply
# supabase/schema.sql in the SQL editor before setting these.
# Use the anon/public key here only — never the service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Storage bucket for permanent video files (created by schema.sql).
SUPABASE_VIDEO_BUCKET=josh-videos

# --- Livestreaming (stage 8 activation) ------------------------------
# RTMP ingest endpoint and stream key from the provider you choose.
# Left empty, the live page shows setup state instead of pretending to stream.
LIVE_RTMP_URL=
LIVE_STREAM_KEY=
